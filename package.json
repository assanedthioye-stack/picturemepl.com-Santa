{
  "name": "picture-me-please",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @pmp/desktop dev",
    "build": "pnpm --filter @pmp/desktop build",
    "dist:win": "pnpm --filter @pmp/desktop dist:win",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @pmp/db generate"
  }
}
